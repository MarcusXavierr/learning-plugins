{
  "name": "learning-plugins",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --format ./.sensors/maintainability/eslint-formatter-custom.cjs .",
    "lint:sensor": "eslint --format ./.sensors/maintainability/eslint-formatter-json.cjs .",
    "structure": "sh .sensors/maintainability/structure.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run .sensors/maintainability/stryker.config.mjs",
    "knip": "knip --config .sensors/maintainability/knip.json --include files,exports,nsExports,types,nsTypes,duplicates",
    "build": "node build/cli.ts build",
    "check": "node build/cli.ts check",
    "validate": "node build/cli.ts validate",
    "test:claude": "node build/cli.ts test-claude",
    "types:claude": "node build/cli.ts refresh-claude-types"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@oh-my-pi/pi-coding-agent": "18.2.10",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-llm-core": "0.37.0",
    "knip": "6.41.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
